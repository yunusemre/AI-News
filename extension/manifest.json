{
  "manifest_version": 3,
  "name": "News — AI ve yazılım haberleri",
  "short_name": "News",
  "version": "1.0.0",
  "description": "AI ve yazılım haberleri — Türkçe, kısa, gürültüsüz. Yeni sekmede ve araç çubuğunda.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "News",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://news-2afea-default-rtdb.firebaseio.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}